# Copie para .env e preencha. O .env real fica fora do git.
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=True
# Hosts separados por vírgula em produção, ex: meusite.com,www.meusite.com
DJANGO_ALLOWED_HOSTS=
# Em produção, mantenha True se o app recebe HTTPS diretamente.
# Se houver proxy/reverse proxy terminando TLS, configure o proxy antes de mudar.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
