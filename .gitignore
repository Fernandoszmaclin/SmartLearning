# ============================================================
#  Study repo — .gitignore
#  Ignora artefatos descartáveis e arquivos com informação
#  sensível/frágil (local da máquina, banco, segredos, etc.)
# ============================================================

# ---- Segredos / ambiente ----
.env
.env.*
*.env
!.env.example
secrets.json
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- Ambiente virtual ----
.venv/
venv/
env/
ENV/

# ---- Django ----
*.sqlite3
*.sqlite3-journal
db.sqlite3
media/
staticfiles/
/static_root/
*.log
local_settings.py
settings_local.py

# ---- Node / front-end ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Renders / mídia pesada ----
videos/

# ---- Ferramentas locais / config da máquina ----
.code-review-graph/
.claude/
.agents/
.mcp.json
skills-lock.json

# ---- Editores / IDEs ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- SO ----
.DS_Store
Thumbs.db
desktop.ini
